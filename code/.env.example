# Copy to code/.env and fill in at build time.
# Names only. Never commit real keys, tokens or addresses.
# Every name below is read by si_console/config.py.

# --- Secrets (required for live runs, not for tests) ---
DEEPSEEK_API_KEY=
BRIDGE_API_TOKEN=

# --- DeepSeek ---
# Pin the model names after checking the official DeepSeek platform
# page. Do not hard-code a model name in code.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
SI_DEEPSEEK_DAILY_CAP_USD=5.0
SI_DEEPSEEK_MAX_TOKENS=2000
SI_DEEPSEEK_TIMEOUT_SECONDS=30

# --- Accepted model roster (docs/MODEL_TIERS.md) ---
# A slot with no key or no model id is skipped; its tier falls back to
# the next slot. Model ids: copy from each provider's model list.
#   T0 orchestrator : DeepSeek -> Hy4 -> GLM 5.3 Flash
#   T1 heavy        : Qwen4 Max -> escalate to human
#   T2 medium       : Hy4 -> DeepSeek -> GLM 5.3 Flash
#   T3 small        : MiMo 2.6 Flash -> $0 code paths
# Tencent Hunyuan (Hy4) on TokenHub: key at console.cloud.tencent.com/tokenhub/apikey
# (Guangzhou site; a Singapore-site key needs the -intl URL below). Model e.g. hy4-preview.
HUNYUAN_API_KEY=
HY4_MODEL=
# HUNYUAN_BASE_URL=https://tokenhub.tencentcloudmaas.com/v1
# (Singapore site: https://tokenhub-intl.tencentcloudmaas.com/v1)
# Zhipu GLM 5.3 Flash (5.4 API not out yet): open.bigmodel.cn (mainland key)
GLM_API_KEY=
GLM_MODEL=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# The GLM key also runs web search (Zhipu Web Search API, ~0.01 CNY per
# search on search_std). Engines: search_std, search_pro, search_pro_sogou,
# search_pro_quark. On a Z.ai (api.z.ai) key, search-prime is used.
# ZHIPU_SEARCH_ENGINE=search_std
# Alibaba Bailian / Model Studio (Qwen4 Max), Hong Kong region key.
# Keys are regional: the URL must match the key's region or you get 401.
DASHSCOPE_API_KEY=
QWEN_MODEL=
# DASHSCOPE_BASE_URL=https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1
# (Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1)
# Xiaomi MiMo 2.6 Flash: platform.xiaomimimo.com
MIMO_API_KEY=
MIMO_MODEL=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
SI_PROVIDER_TIMEOUT_SECONDS=30

# --- Jev 1.14 judge, direct from TypeSafe (docs.typesafe.ai) ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
# JEV_URL=https://api.typesafe.ai/v1/systemone
# Alternate route: leave TYPESAFE_API_KEY empty, set OPENROUTER_API_KEY,
# and use JEV_MODEL=typesafe/jev-1.14 (OpenRouter's id format).
# OPENROUTER_API_KEY=
SI_JEV_TIMEOUT_SECONDS=5
# Judge backups, used only if the one before does not respond:
# 1. Bailian decision model (same System One API as Jev, calibrated) on
#    the same HK key. It needs the workspace host: paste the workspace id
#    ("llm-...") or the whole API Host from Model Studio > Workspace
#    Management > API Host (Hong Kong region).
BAILIAN_WORKSPACE_ID=
# BAILIAN_DECISION_MODEL=decision-model
# BAILIAN_REGION=cn-hongkong
SI_BAILIAN_DECISION_TIMEOUT_SECONDS=5
# 2. Last resort: a small Qwen chat model in JSON mode (verified on the HK
#    workspace: qwen3.8-flash, qwen3.7-flash, qwen3.6-flash).
QWEN_JUDGE_MODEL=qwen3.8-flash
SI_QWEN_JUDGE_TIMEOUT_SECONDS=5

# --- Arena panes A, B, C ---
# Pin: auto | deepseek-v4.1-flash | hy4 | glm-5.3-flash
# T2 allowlist: all | none | comma list of hy4,deepseek-v4.1-flash,glm-5.3-flash
# T1: on | off      FALLBACK: yes | no (fall back down the T0 chain when pinned)
SI_ORCH_A=auto
SI_ORCH_B=hy4
SI_ORCH_C=glm-5.3-flash
SI_ORCH_A_T2=all
SI_ORCH_B_T2=all
SI_ORCH_C_T2=all
SI_ORCH_A_T1=on
SI_ORCH_B_T1=on
SI_ORCH_C_T1=on
SI_ORCH_A_FALLBACK=yes
SI_ORCH_B_FALLBACK=yes
SI_ORCH_C_FALLBACK=yes
# Which pane this coordinator process serves (one process per pane)
SI_COORDINATOR_PANE=A
# SI_TELEMETRY_PATH=/home/pi/si-console/telemetry.sqlite

# --- Paths (defaults are under code/; uncomment to override) ---
# SI_VAULT_PATH=/home/pi/si-console/vault/si-console
# SI_STATE_PATH=/home/pi/si-console/state.json
# SI_CLAIMS_PATH=/home/pi/si-console/claims.json
# SI_DATA_DIR=/home/pi/si-console/data/market

# --- Bridge and dashboard ---
SI_BRIDGE_HOST=127.0.0.1
SI_BRIDGE_PORT=8001
SI_DASHBOARD_PORT=8000

# --- Coordinator loop ---
SI_ROUND_LIMIT=3
SI_APPROVAL_TIMEOUT_SECONDS=120
SI_STUCK_SECONDS=300
SI_WATCHDOG_INTERVAL_SECONDS=30

# --- Mode ---
SI_MODE=booth
SI_REPLAY_SCENARIO=2020
SI_LANG=en

# --- Scheduler ---
SI_BRIEFING_HOUR=11
SI_BRIEFING_MINUTE=0
SI_SCHEDULER_MISFIRE_GRACE_SECONDS=3600

# --- Claude (not in the roster; no Anthropic client in this build) ---
SI_CLAUDE_ENABLED=false
# SI_CLAUDE_MODEL_PREMIUM=
