# The coordinator runs the agent loop. It does not touch GPIO. It does
# not touch state.json directly. It writes the vault, and the bridge
# follows. The coordinator waits for the bridge to be up first.
# Install with:
# sudo cp coordinator.service /etc/systemd/system/
# sudo systemctl enable --now coordinator.service
[Unit]
Description=SI Console coordinator
After=bridge.service
Requires=bridge.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/si-console
ExecStart=/home/pi/si-console/.venv/bin/python3 -m si_console.coordinator
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
