# DRAFT REFERENCE, TO BE REVIEWED AND REWRITTEN BY THE TEAM.
# SI Console coordinator unit. TEMPLATE: @USER@ and @CODE_DIR@ are
# filled in by deploy/install_pi.sh. The coordinator runs the agent
# loop for one arena pane (SI_COORDINATOR_PANE in .env). It does not
# touch GPIO. It writes the vault, and the bridge follows.
# It starts after the network and the clock are up, because every
# model provider is reached over HTTPS, and HTTPS fails on a wrong
# clock (the Pi has no RTC battery by default).
[Unit]
Description=SI Console coordinator
After=bridge.service network-online.target time-sync.target
Wants=network-online.target
Requires=bridge.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@CODE_DIR@
ExecStart=@CODE_DIR@/.venv/bin/python3 -m si_console.coordinator
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
