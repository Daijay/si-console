# SI Console bridge unit. TEMPLATE: @USER@ and @CODE_DIR@ are filled in
# by deploy/install_pi.sh, which writes the result to
# /etc/systemd/system/bridge.service. Do not copy this file by hand.
# @CODE_DIR@ is the repo's code/ folder (the one holding si_console/
# and .env), e.g. /home/<you>/si-console/code. Restart on failure.
[Unit]
Description=SI Console bridge
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@CODE_DIR@
ExecStart=@CODE_DIR@/.venv/bin/uvicorn si_console.bridge:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
# On stop, set all GPIO outputs low, so the LEDs go to a safe state.
# The pins come from gpio_map.py, the single source of truth.
ExecStop=@CODE_DIR@/.venv/bin/python3 -c "from gpiozero import LED; from si_console import gpio_map as g; [LED(p).off() for p in list(g.STATUS_LEDS.values()) + list(g.BUTTON_LEDS.values())]"

[Install]
WantedBy=multi-user.target
