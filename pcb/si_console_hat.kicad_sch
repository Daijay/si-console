(text "LED driver" (exclude_from_sim no) (at 150 34 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "11f23618-1cd8-5ac2-8e0c-4e90ab254e93"))
(text "Status LEDs (off board)" (exclude_from_sim no) (at 205 22 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "8222e087-b0e9-599c-b21b-1d524c82fd12"))
(text "Buttons and switches (off board). Inputs use the Pi internal pull-ups, active LOW." (exclude_from_sim no) (at 20 122 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "38a32ad5-fda2-5ad9-937c-b6b9d74a4a20"))
(text "J6/J7 pins: 1 switch, 2 GND, 3 LED+ (5 V, resistor built into the button), 4 LED-." (exclude_from_sim no) (at 20 154 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c5927029-db9a-5f78-ab23-3d37b1292494"))
(text "J8 pins: 1-2 kill contact A (NC, to GPIO22). 3-4 kill contact B (second NC), optional interlock." (exclude_from_sim no) (at 20 157 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4400483e-fa67-5ee7-b7fa-712f1430a6b6"))
(text "Optional kill interlock, OFF as built: JP1 closed, JP2 open.\nTo enable: wire contact B to J8 pins 3-4, CUT JP1, SOLDER JP2.\nContact B is then in series with the green button signal." (exclude_from_sim no) (at 20 192 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8d92d7a2-4417-51e5-976a-afa3edae0fc7"))
